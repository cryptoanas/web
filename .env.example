# Solana + Drift
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
DRIFT_ENV=mainnet-beta
DRIFT_WEBSOCKET_URL=wss://api.mainnet-beta.solana.com
DRIFT_MARKET_INDEX=0
# keypair as JSON array string: [1,2,...]
SOLANA_KEYPAIR_JSON=[]

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=123456789

# Runtime
CONFIG_PATH=./config/runtime-config.json
LOG_LEVEL=info
